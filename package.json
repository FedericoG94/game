{
  "name": "carlotta-gift-run",
  "version": "1.0.0",
  "private": true,
  "description": "Carlotta's Gift Run - endless runner arcade 2.5D con finale personalizzato (Phaser 3 + Vite).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
